{
  "name": "pi-extensions-collection",
  "version": "0.0.0",
  "private": true,
  "description": "Extensions for Pi coding agent, installed as one git package. No npm publishing, no build step; dependencies are installed by Pi.",
  "type": "module",
  "workspaces": [
    "ask-user",
    "background-terminal",
    "bash-timeout",
    "goal",
    "subagent"
  ],
  "pi": {
    "extensions": [
      "./ask-user/ask-user.ts",
      "./background-terminal/background-terminal.ts",
      "./bash-timeout/bash-timeout.ts",
      "./goal/goal.ts",
      "./subagent/subagent.ts"
    ]
  },
  "scripts": {
    "test": "node --test scripts/*.test.mjs && npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0"
  }
}
