{
  "name": "pi-extensions-collection",
  "version": "0.0.0",
  "private": true,
  "description": "Extensions for Pi coding agent, installed as one git package. No npm publishing, no build step; dependencies are installed by Pi.",
  "type": "module",
  "workspaces": [
    "ask-user",
    "auto-compact",
    "background-terminal",
    "bash-timeout",
    "context-prune",
    "goal",
    "subagent"
  ],
  "pi": {
    "extensions": [
      "./ask-user/ask-user.ts",
      "./auto-compact/auto-compact.ts",
      "./background-terminal/background-terminal.ts",
      "./bash-timeout/bash-timeout.ts",
      "./context-prune/context-prune.ts",
      "./goal/goal.ts",
      "./subagent/subagent.ts"
    ]
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
